# Build artifacts
/target
/result
/result-*

# Internal docs (reviews, feedback, specs) stay local. The garden's papers do
# not: the tend2 map, the copeca A/B briefs, and the output-parity proof are
# part of the repository.
/docs/*
!/docs/tend2/
!/docs/ab/
!/docs/proof-2026-09.md
!/docs/metrics/

# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# Python
__pycache__/
*.pyc

# Benchmark
benchmark/fixtures/repo/
benchmark/fixtures/repos/
benchmark/results/*.jsonl
benchmark/results/*.md
!benchmark/results/.gitkeep

# Brand (petals). The umbrella-derived files (.brand/*.md, tokens.css,
# tokens.json, assets/) are pulled from plotplot and kept local; the product
# layer .brand/products/tilth/ is this bed's own identity and is committed.
.petalsrc
.brand/*
!.brand/products/
